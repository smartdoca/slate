{
  "name": "@smartdoca/slate",
  "version": "0.4.13",
  "description": "A Feishu-inspired, extensible rich text editor built with Slate and TypeScript.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./katex": {
      "types": "./dist/katex.d.ts",
      "import": "./dist/katex.js",
      "require": "./dist/katex.cjs"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "import": "./dist/codec.js",
      "require": "./dist/codec.cjs"
    },
    "./conversion": {
      "types": "./dist/conversion/index.d.ts",
      "import": "./dist/conversion.js",
      "require": "./dist/conversion.cjs"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js",
      "require": "./dist/headless.cjs"
    },
    "./yjs": {
      "types": "./dist/yjs.d.ts",
      "import": "./dist/yjs.js",
      "require": "./dist/yjs.cjs"
    },
    "./languages": {
      "types": "./dist/languages.d.ts",
      "import": "./dist/languages.js",
      "require": "./dist/languages.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "test-fixtures/conversion",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:node-esm": "node scripts/verify-node-esm.mjs",
    "test:collaboration-idle": "node scripts/verify-collaboration-idle.mjs",
    "test:performance": "vitest run src/collaborationPerformance.test.ts src/largeDocument.test.tsx",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "katex": "^0.18.7",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "slate": ">=0.100.0",
    "slate-dom": ">=0.116.0",
    "slate-history": ">=0.100.0",
    "slate-react": ">=0.100.0"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    }
  },
  "dependencies": {
    "@antv/x6": "2.19.2",
    "@antv/x6-plugin-clipboard": "2.1.6",
    "@antv/x6-plugin-export": "^2.1.6",
    "@antv/x6-plugin-history": "2.2.4",
    "@antv/x6-plugin-keyboard": "2.2.3",
    "@antv/x6-plugin-minimap": "2.0.7",
    "@antv/x6-plugin-selection": "2.2.2",
    "@antv/x6-plugin-snapline": "2.1.7",
    "@antv/x6-plugin-transform": "2.1.8",
    "@xmldom/xmldom": "^0.8.11",
    "jszip": "^3.10.1",
    "lucide-react": "^0.542.0",
    "prismjs": "^1.30.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "katex": "0.18.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "slate": "^0.118.1",
    "slate-dom": "^0.118.1",
    "slate-history": "^0.113.1",
    "slate-react": "^0.118.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "slate",
    "rich-text",
    "editor",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartdoca/slate.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
